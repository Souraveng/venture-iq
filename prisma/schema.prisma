datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

model Startup {
  id           String  @id @default(uuid())
  name         String
  tagline      String
  category     String
  stage        String
  valuation    String
  targetAmount String
  raisedAmount String
  founder      String
  location     String
  traction     String
  pitchDeckUrl String  @default("#")
  verified     Boolean @default(false)
  isPublished  Boolean @default(false)
  videoFormat  String  @default("16:9")

  // Link to Founder
  founderId      String?
  founderProfile Founder? @relation(fields: [founderId], references: [id])

  // Step 3: Startup Profile
  industry      String?
  subIndustry   String?
  businessModel String?
  country       String?
  state         String?
  city          String?
  teamSize      String?

  // Step 4: Funding (using existing valuation, targetAmount, raisedAmount)
  monthlyBurn    String?
  monthlyRevenue String?
  ebitda         String?
  grossMargin    String?
  problemText    String?
  solutionText   String?

  // Step 5: Customers
  payingCustomers    String?
  monthlyActiveUsers String?
  arrMrr             String?
  growthRate         String?
  customerGeography  String?

  // Step 6: Documents
  businessPlanUrl   String?
  financialModelUrl String?
  onePagerUrl       String?

  // Hidden AI Fields
  investorReadinessScore Float?
  marketScore            Float?
  riskScore              Float?
  moatScore              Float?
  executionScore         Float?
  aiSummary              String?  @db.Text
  keywords               String[] @default([])
  embedding              Unsupported("vector(1024)")?
  fundingProbability     Float?
  recommendedInvestors   String[] @default([])
  // Spec Additions
  logoUrl               String?
  websiteUrl            String?
  linkedinUrl           String?
  twitterUrl            String?
  roundType             String?
  fixedValuation        String?
  valuationCap          String?
  equityOffered         String?
  minTicket             String?
  interestRate          String?
  roundStatus           String?
  targetCloseDate       String?
  mrr                   String?
  arr                   String?
  mrrGrowthRate         String?
  burnRate              String?
  cashInBank            String?
  runway                String?
  priorFundingRaised    String?
  priorNotableInvestors String?
  tam                   String?
  sam                   String?
  som                   String?
  useOfFunds            Json?
  teamRoster            Json?
  gatedFields           Json?

  // Pre-seed specific fields
  ideaStage               String?
  coreProblem             String?
  whyNow                  String?
  uniqueInsight           String?
  proposedSolution        String?
  technicalApproach       String?
  techStack               String?
  demoLink                String?
  validationActivity      String?
  validationDetail        String?
  willingnessToPaySignal  String?
  whyThisTeam             String?
  differentiation         String?
  ipAssets                String?
  keyMilestone            String?
  vision                  String?

  analysisRuns AnalysisRun[]
  analyticsEvents StartupAnalyticsEvent[]
  escalations  Escalation[]
  collaborators   VentureCollaborator[]
  handoffNotes    HandoffNote[]
}

model Investor {
  id                   String   @id @default(uuid())
  email                String?  @unique
  username             String?  @unique
  name                 String
  firm                 String?
  avatarUrl            String?
  investorType         String   @default("Individual Angel")
  role                 String?
  focusSectors         String[] @default([])
  preferredStages      String[] @default([])
  preferredInstruments String[] @default([])
  minCheckSize         String   @default("")
  maxCheckSize         String   @default("")
  checkSize            String   @default("")
  thesis               String?
  verified             Boolean  @default(true)
  accreditationStatus  String   @default("Accredited Investor (Verified)")
  activityStatus       String   @default("Actively deploying this quarter")

  // Nice-To-Haves
  portfolioCompanies String[] @default([])
  portfolioCount     Int      @default(0)
  valueAdd           String[] @default([])
  geoPreferences     String   @default("")
  investmentStyle    String   @default("")
  decisionSpeed      String   @default("")
  followOnCapacity   String   @default("")
  responseRate       String   @default("")
  trustScore         String   @default("")
  location           String   @default("")
  linkedIn           String?
  twitter            String?

  // Onboarding Additions
  isLeadInvestor      Boolean?
  followsOn           Boolean?
  businessPreferences String[] @default([])
  riskAppetite        String?
  previousExits       Int?
  currentInterestText String?  @db.Text

  // Hidden AI Fields
  investorEmbedding         Json?
  preferredStartupEmbedding Json?
  activityScore             Float?
  matchHistory              Json?
  portfolioSimilarity       Float?
  autonomousEnabled         Boolean  @default(true)
  lastAutonomousRun         DateTime?

  analysisRuns AnalysisRun[]
}

enum AnalysisRunStatus {
  DRAFT
  AWAITING_EVIDENCE
  QUEUED
  RUNNING
  VERIFYING
  COMPLETED
  FAILED
  CANCELLED
}

enum EvidenceSourceType {
  STARTUP_PROFILE
  UPLOADED_DOCUMENT
  VERIFIED_WEB_SOURCE
  INTERNAL_KNOWLEDGE
  USER_INPUT
}

enum FindingStatus {
  SUPPORTED
  INSUFFICIENT_EVIDENCE
  NEEDS_REVIEW
  CONFLICTING_EVIDENCE
}

enum RecommendationType {
  INVEST
  MONITOR
  PASS
  REQUEST_INFORMATION
  NEXT_STEP
}

model AnalysisRun {
  id             String            @id @default(uuid())
  startupId      String
  investorId     String?
  investorEmail  String?
  goal           String            @default("INVESTMENT_DILIGENCE")
  status         AnalysisRunStatus @default(DRAFT)
  runtimeVersion String
  inputSnapshot  Json
  sharedState    Json?
  errorMessage   String?           @db.Text
  requestedAt    DateTime          @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  startup         Startup                  @relation(fields: [startupId], references: [id], onDelete: Cascade)
  investor        Investor?                @relation(fields: [investorId], references: [id], onDelete: SetNull)
  evidence        AnalysisEvidence[]
  findings        AnalysisFinding[]
  scorecards      AnalysisScorecard[]
  recommendations AnalysisRecommendation[]

  @@index([startupId, createdAt])
  @@index([investorEmail, createdAt])
  @@index([status])
}

model AnalysisEvidence {
  id               String             @id @default(uuid())
  analysisRunId    String
  sourceType       EvidenceSourceType
  title            String
  sourceUrl        String?
  excerpt          String?            @db.Text
  claim            String?            @db.Text
  credibilityScore Float?
  publishedAt      DateTime?
  verifiedAt       DateTime?
  createdAt        DateTime           @default(now())

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId])
}

model AnalysisFinding {
  id            String        @id @default(uuid())
  analysisRunId String
  engine        String
  title         String
  content       String        @db.Text
  status        FindingStatus @default(INSUFFICIENT_EVIDENCE)
  confidence    Float?
  evidenceRefs  String[]      @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId, engine])
}

model AnalysisScorecard {
  id            String   @id @default(uuid())
  analysisRunId String
  framework     String
  totalScore    Float?
  weights       Json
  components    Json
  explanation   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId, framework])
}

model AnalysisRecommendation {
  id            String             @id @default(uuid())
  analysisRunId String
  type          RecommendationType
  title         String
  rationale     String             @db.Text
  priority      Int                @default(0)
  confidence    Float?
  evidenceRefs  String[]           @default([])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId, priority])
}

model Founder {
  id                String   @id @default(uuid())
  email             String?  @unique
  username          String?  @unique
  fullName          String   @default("")
  roleTitle         String   @default("")
  avatarUrl         String   @default("")
  location          String   @default("")
  linkedinUrl       String   @default("")
  commitment        String   @default("Full-time")
  equityStake       String   @default("")
  startupName       String   @default("")
  startupLink       String   @default("/founder/fundraising")
  aboutQuote        String   @default("")
  aboutText         String   @default("")
  domainExpertise   String[] @default([])
  keySkills         String[] @default([])
  teamSize          String   @default("")
  verificationBadge String   @default("Identity Verified (Tier 1)")
  introVideoUrl     String   @default("")
  background        Json[]   @default([])

  startups Startup[]
}

model Negotiation {
  id                String @id @default(uuid())
  startupName       String
  investorFirm      String
  roundStage        String
  proposedValuation String
  checkAmount       String
  termSheetStatus   String // Draft, Under Review, Term Sheet Signed, Completed
  lastUpdated       String
}

model Meeting {
  id           String  @id @default(uuid())
  investorName String
  firm         String
  startupName  String
  date         String
  time         String
  mode         String // Google Meet, In-Person
  link         String?
  status       String // Confirmed, Pending, Cancelled
  agenda       String
  pitchDeck    String?
  notes        String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  username      String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  role          String    @default("founder") // active/primary role
  roles         String[]  @default(["founder"]) // list of enabled roles e.g. ["founder", "investor"]
  onboarded        Boolean   @default(false)
  lastActiveTeamId String?
  publicKey        UserPublicKey?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Validation {
  id                   String   @id @default(uuid())
  idea                 String
  marketViability      Int      @default(85)
  technicalFeasibility Int      @default(78)
  financialPlanning    String   @default("22 Months")
  overallGrade         String   @default("A-")
  createdAt            DateTime @default(now())
  userEmail            String?
  reports              Json?
}

model UserPublicKey {
  id        String   @id @default(uuid())
  userId    String   @unique
  publicKey String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatRoom {
  id         String        @id @default(uuid())
  founderId  String
  investorId String
  status     String        @default("PENDING") // PENDING, ACCEPTED, REJECTED
  initiatedBy String?      // Email of the person who sent the first message
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  messages   ChatMessage[]

  @@unique([founderId, investorId])
}

model ChatMessage {
  id               String   @id @default(uuid())
  chatRoomId       String
  senderId         String
  encryptedPayload String   @db.Text // Encrypted ciphertext
  iv               String   // Initialization Vector (salt)
  createdAt        DateTime @default(now())

  // New Social Chat Features
  reactions        Json?    @default("{}") // e.g. { "❤️": ["email1"] }
  readAt           DateTime?
  replyToId        String?
  isPinned         Boolean  @default(false)

  chatRoom         ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
}

enum InteractionState {
  EXPLORED
  SHORTLISTED
  INTRO_REQUESTED
  PASSED
  MUTUAL_MATCH
  AUTONOMOUS_RECOMMENDATION_PENDING
}

model DealInteraction {
  id         String           @id @default(uuid())
  investorId String
  startupId  String
  state      InteractionState
  feedback   String?          @db.Text // Reason for passing or additional notes
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // For now, these are not directly tied via @relation since relations might require updating the other models
  // and investorId might refer to a User or Investor model. We'll rely on the IDs.
  
  @@unique([investorId, startupId])
}

model InvestorActivityEvent {
  id         String   @id @default(uuid())
  investorId String
  startupId  String
  eventType  String   // e.g. "VIDEO_WATCHED_10S", "VIEW_SPECS", "VIEW_DECK", "SKIP_FAST", "DWELL_HIGH"
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([investorId, createdAt])
  @@index([startupId])
}

model Post {
  id          String   @id @default(uuid())
  authorEmail String
  authorUsername String?
  authorName  String
  authorRole  String   @default("User")
  authorAvatar String?
  content     String   @db.Text
  mediaUrl    String?
  tags        String[] @default([])
  likes       Int      @default(0)
  likedBy     String[] @default([])
  comments    Comment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id          String   @id @default(uuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorEmail String
  authorName  String
  authorAvatar String?
  content     String   @db.Text
  createdAt   DateTime @default(now())
}

model ConnectionRequest {
  id            String   @id @default(uuid())
  senderEmail   String
  receiverEmail String
  status        String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([senderEmail, receiverEmail])
}

model DirectMessage {
  id            String   @id @default(uuid())
  senderEmail   String
  receiverEmail String
  text          String   @db.Text
  createdAt     DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userEmail String   
  type      String   // e.g., PROFILE_UPDATE, CONNECTION_REQUEST, CHAT_MOVEMENT, etc.
  title     String
  message   String
  timestamp DateTime @default(now())
  read      Boolean  @default(false)
  category  String   // e.g., connection, profile, chat, request, etc.
  metadata  Json?
}

enum AnalyticsEventType {
  PROFILE_VIEW
  VIDEO_VIEW
  DECK_VIEW
  FEED_IMPRESSION
}

model StartupAnalyticsEvent {
  id         String             @id @default(uuid())
  startupId  String
  investorId String?            // email or ID of the investor who performed the action
  eventType  AnalyticsEventType
  createdAt  DateTime           @default(now())

  startup    Startup            @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId, eventType])
}

enum EscalationStatus {
  PENDING
  REVIEWED
  ACTIONED
  REJECTED
}

model Escalation {
  id              String           @id @default(uuid())
  startupId       String
  escalatedBy     String           // Email of the analyst escalating
  escalatedToRole String           // e.g., "Investment Committee"
  analystNote     String?          @db.Text
  aiHandoffNote   String           @db.Text
  status          EscalationStatus @default(PENDING)
  shareWithAll    Boolean          @default(true)
  sharedWithEmails String[]        @default([])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  startup         Startup          @relation(fields: [startupId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([escalatedToRole, status])
  @@index([escalatedBy])
}

enum TeamRole {
  OWNER
  EDITOR
  VIEWER
}

enum TeamType {
  INVESTOR
  FOUNDER
}

enum MemberStatus {
  PENDING
  ACTIVE
  DECLINED
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  teamType    TeamType @default(INVESTOR)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     TeamMember[]
  escalations Escalation[]
}

model TeamMember {
  id        String       @id @default(uuid())
  teamId    String
  userEmail String
  role      TeamRole     @default(VIEWER)
  modulePermissions Json?
  status    MemberStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userEmail])
}

// ── Venture-scoped Collaboration (GCP IAM-style) ──

enum VentureRole {
  OWNER    // Co-founder level: full access including team management & danger zone
  EDITOR   // Key contributor: can edit venture data, view analytics, attend meetings
  VIEWER   // Observer: read-only access to dashboards, validation history, profile
}

enum CollaboratorStatus {
  PENDING   // Invitation sent, not yet accepted
  ACTIVE    // Accepted and actively collaborating
  REVOKED   // Access was revoked by an owner
}

model VentureCollaborator {
  id          String              @id @default(uuid())
  startupId   String
  userEmail   String
  role        VentureRole         @default(VIEWER)
  invitedBy   String
  status      CollaboratorStatus  @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  startup     Startup             @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([startupId, userEmail])
  @@index([userEmail])
}

model HandoffNote {
  id             String   @id @default(uuid())
  startupId      String
  createdBy      String
  assignedTo     String?
  title          String
  context        String   @db.Text
  pendingActions String?  @db.Text
  keyDecisions   String?  @db.Text
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  startup        Startup  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId, assignedTo])
}

model CachedFact {
  id         String   @id
  sector     String
  geography  String
  claim      String   @db.Text
  value      Float?
  unit       String?
  confidence String
  sourceUrl  String?
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime @default(now())

  @@index([sector, geography, createdAt])
}

// ── Connect Hub Models ──────────────────────────────────

model Follow {
  id            String   @id @default(uuid())
  followerEmail String
  followingEmail String
  createdAt     DateTime @default(now())

  @@unique([followerEmail, followingEmail])
  @@index([followerEmail])
  @@index([followingEmail])
}

model PostReaction {
  id         String   @id @default(uuid())
  postId     String
  userEmail  String
  reaction   String   // fire | insight | vibe | launch | love
  createdAt  DateTime @default(now())

  @@unique([postId, userEmail])
  @@index([postId])
}

model Story {
  id          String   @id @default(uuid())
  authorEmail String
  authorName  String
  authorAvatar String?
  authorRole  String   @default("Founder")
  mediaUrl    String?
  text        String?  @db.Text
  expiresAt   DateTime
  viewedBy    String[] @default([])
  createdAt   DateTime @default(now())

  @@index([authorEmail])
  @@index([expiresAt])
}

// ── WebRTC Signaling ──────────────────────────────────
model WebRTCSignal {
  id            String   @id @default(uuid())
  chatRoomId    String
  senderEmail   String
  receiverEmail String
  type          String   // offer, answer, ice-candidate
  payload       Json
  createdAt     DateTime @default(now())

  @@index([chatRoomId, receiverEmail])
}
